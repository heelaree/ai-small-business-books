{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SmallBusinessBooksData",
  "description": "Normalized contract between bank statement extraction (reconcile_ledger.py) and reporting generators (build_all.py).",
  "type": "object",
  "required": ["documents", "raw", "ledger", "transfers", "review"],
  "properties": {
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file"],
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string" },
          "account": { "type": "string" },
          "currency": { "type": "string" },
          "owner": { "type": "string" },
          "start": { "type": "string", "format": "date" },
          "end": { "type": "string", "format": "date" },
          "opening": { "type": "number" },
          "closing": { "type": "number" },
          "credits": { "type": "number" },
          "debits": { "type": "number" },
          "is_consolidated": { "type": "boolean" }
        }
      }
    },
    "raw": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["raw_id", "statement", "seq", "date", "account", "description", "debit", "credit", "balance"],
        "properties": {
          "raw_id": { "type": "string" },
          "statement": { "type": "string" },
          "seq": { "type": "integer" },
          "date": { "type": "string", "format": "date" },
          "datetime": { "type": "string" },
          "account": { "type": "string" },
          "description": { "type": "string" },
          "debit": { "type": "number" },
          "credit": { "type": "number" },
          "balance": { "type": "number" },
          "charge": { "type": "number" },
          "counterparty": { "type": "string" },
          "source_account": { "type": "string" },
          "reference": { "type": "string" },
          "pages": { "type": "string" }
        }
      }
    },
    "ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "raw_id", "date", "account", "description", "component", "amount", "section", "category"],
        "properties": {
          "id": { "type": "string" },
          "raw_id": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "account": { "type": "string" },
          "description": { "type": "string" },
          "component": { "enum": ["Principal", "Embedded fee"] },
          "amount": { "type": "number" },
          "section": { "type": "string" },
          "category": { "type": "string" },
          "transfer_id": { "type": "string" },
          "question": { "type": "string" }
        }
      }
    }
  }
}
